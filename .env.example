# Supabase (client-safe publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Jangan pernah pakai prefix NEXT_PUBLIC_ atau kirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 untuk foto produk. Server-only, jangan pakai NEXT_PUBLIC_.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=kpr-pos-produk
R2_PUBLIC_URL=https://img.example.com

# Hanya untuk seed Owner lokal: npm run seed:owner
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me
